---
import { getCollection } from "astro:content";
import WorkshopDetailLayout from "@layouts/WorkshopDetailLayout.astro";

export async function getStaticPaths() {
  const workshops = await getCollection("workshops", ({ data }) => {
    return data.lang === "pt" && data.location === "santa-cruz" && !data.draft;
  });

  return workshops.map((workshop) => ({
    params: { slug: workshop.data.slug },
    props: { workshop },
  }));
}

const { workshop } = Astro.props;
---

<WorkshopDetailLayout workshop={workshop} />

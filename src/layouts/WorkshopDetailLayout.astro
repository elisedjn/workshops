---
import { render, type CollectionEntry } from "astro:content";
import LinkButton from "@components/LinkButton.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { type Locale } from "@i18n/config";
import { withBase } from "@i18n/routes";
import { getWorkshopLocationPath, getWorkshopPath } from "@i18n/workshops";
import { sharedText, siteName } from "@i18n/ui";

interface Props {
  workshop: CollectionEntry<"workshops">;
}

const { workshop } = Astro.props;
const { Content } = await render(workshop);
const lang = workshop.data.lang as Locale;
const routeKey = workshop.data.location === "santa-cruz" ? "santaCruz" : workshop.data.location === "at-home" ? "atHome" : "ericeira";
const canonicalPath = getWorkshopPath(workshop.data.location, lang, workshop.data.slug);
const parentPath = getWorkshopLocationPath(workshop.data.location, lang);
const bookingUrl = workshop.data.bookingUrl ?? "mailto:hello@example.com";
const labels = {
  en: {
    back: "Back to workshops",
    date: "Date",
    duration: "Duration",
    price: "Price",
    audience: "For",
  },
  fr: {
    back: "Retour aux ateliers",
    date: "Date",
    duration: "Durée",
    price: "Prix",
    audience: "Pour",
  },
  pt: {
    back: "Voltar aos workshops",
    date: "Data",
    duration: "Duração",
    price: "Preço",
    audience: "Para",
  },
}[lang];
---

<BaseLayout
  title={`${workshop.data.title} | ${siteName}`}
  description={workshop.data.description}
  lang={lang}
  routeKey={routeKey}
  canonicalPath={canonicalPath}
  image={workshop.data.image}
>
  <article class="mx-auto max-w-5xl px-5 py-16">
    <a href={withBase(parentPath)} class="text-sm font-black uppercase tracking-[0.18em] text-blue transition hover:text-pink">
      ← {labels.back}
    </a>
    <header class="mt-10 rounded-[2.75rem] bg-pink p-7 shadow-xl shadow-pink/20 md:p-10">
      <div class="rounded-[2.1rem] bg-white/80 p-7 md:p-10">
        <p class="text-sm font-black uppercase tracking-[0.24em] text-blue">{sharedText[lang].allWorkshops}</p>
        <h1 class="mt-5 font-heading text-7xl font-bold leading-[0.82] text-pink md:text-9xl">{workshop.data.title}</h1>
        <p class="mt-7 max-w-3xl text-xl font-bold leading-9 text-grey/75">{workshop.data.description}</p>
      </div>
    </header>

    <section class="mt-8 grid gap-3 md:grid-cols-4">
      <div class="rounded-2xl bg-yellow/35 p-4">
        <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{labels.date}</dt>
        <dd class="mt-1 font-bold text-grey">{workshop.data.date}</dd>
      </div>
      {workshop.data.duration && (
        <div class="rounded-2xl bg-blue/20 p-4">
          <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{labels.duration}</dt>
          <dd class="mt-1 font-bold text-grey">{workshop.data.duration}</dd>
        </div>
      )}
      {workshop.data.price && (
        <div class="rounded-2xl bg-green/25 p-4">
          <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{labels.price}</dt>
          <dd class="mt-1 font-bold text-grey">{workshop.data.price}</dd>
        </div>
      )}
      {workshop.data.audience && (
        <div class="rounded-2xl bg-orange/25 p-4">
          <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{labels.audience}</dt>
          <dd class="mt-1 font-bold text-grey">{workshop.data.audience}</dd>
        </div>
      )}
    </section>

    <div class="prose-workshop mt-10 rounded-[2rem] border border-pink/15 bg-white/75 p-7 shadow-sm md:p-10">
      <Content />
    </div>

    <div class="mt-8">
      <LinkButton href={bookingUrl}>{sharedText[lang].bookCta}</LinkButton>
    </div>
  </article>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import LinkButton from '@components/LinkButton.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { type Locale } from '@i18n/config';
import { localizedRoutes, withBase } from '@i18n/routes';
import { getWorkshopPath } from '@i18n/workshops';
import { getBookingHref } from '../utils/booking';
import { homeContent, nextWorkshopContent, sharedText, siteName } from '@i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = homeContent[lang];
const fallbackNextWorkshop = nextWorkshopContent[lang];
const posts = (
  await getCollection('blog', ({ data }) => data.lang === lang && !data.draft)
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const upcomingWorkshops = (
  await getCollection('workshops', ({ data }) => {
    return data.lang === lang && !data.draft && Boolean(data.startDate);
  })
)
  .filter((workshop) => {
    return workshop.data.startDate && workshop.data.startDate >= new Date();
  })
  .sort((a, b) => {
    return (a.data.startDate?.valueOf() ?? 0) - (b.data.startDate?.valueOf() ?? 0);
  });
const nextWorkshop = upcomingWorkshops[0];
const nextWorkshopHref = nextWorkshop
  ? withBase(getWorkshopPath(nextWorkshop.data.location, lang, nextWorkshop.data.slug))
  : 'mailto:hello@example.com';
const nextWorkshopBookingHref = nextWorkshop
  ? getBookingHref(nextWorkshop.data.bookingUrl, nextWorkshop.data.bookingMessage)
  : 'mailto:hello@example.com';
const aboutParagraphs = content.aboutText.split('\n').map((paragraph) => {
  return paragraph.split(/(\*\*.+?\*\*)/g).map((part) => {
    const isBold = part.startsWith('**') && part.endsWith('**');

    return {
      text: isBold ? part.slice(2, -2) : part,
      isBold,
    };
  });
});
---

<BaseLayout
  title={`${content.seoTitle} | ${siteName}`}
  description={content.seoDescription}
  lang={lang}
  routeKey='home'
>
  <section class='relative isolate pb-8'>
    <div
      class='relative grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:px-[max(1.25rem,calc((100vw-72rem)/2+1.25rem))] lg:py-8'
    >
      <img
        src={withBase('/images/ChezSandy.jpg')}
        alt=''
        class='absolute inset-0 hidden h-full w-full object-cover lg:block'
      />
      <div class='absolute inset-0 hidden bg-grey/45 backdrop-blur-[1px] lg:block'></div>
      <div class='relative overflow-hidden p-7 lg:overflow-visible lg:p-0'>
        <img
          src={withBase('/images/ChezSandy.jpg')}
          alt=''
          class='absolute inset-0 h-full w-full scale-200 object-cover lg:hidden'
        />
        <div class='absolute inset-0 bg-grey/45 backdrop-blur-[1px] lg:hidden'></div>
        <div class='relative'>
          <p
            class='text-sm font-black uppercase tracking-[0.28em] text-right lg:text-left text-white/70'
          >
            {content.eyebrow}
          </p>
          <h1
            class='text-white mt-6 font-heading text-right lg:text-left text-7xl font-bold leading-[0.82] tracking-tight md:text-9xl'
          >
            {content.title}
          </h1>
          <p class='mt-8 max-w-2xl text-white/85'>{content.intro}</p>
        </div>
      </div>
      <aside
        class='mx-5 relative overflow-hidden rounded-[3rem] border border-pink/25 shadow-xl shadow-pink/20'
      >
        <div
          class='relative rounded-[2.3rem] border border-white/35 bg-white/82 p-7 backdrop-blur'
        >
          <p
            class='inline-flex rounded-full bg-green px-4 py-2 text-xs font-black uppercase tracking-[0.22em] text-white'
          >
            {fallbackNextWorkshop.label}
          </p>
          <h2 class='mt-6 font-heading text-4xl font-bold leading-[0.82] text-grey'>
            {nextWorkshop ? nextWorkshop.data.title : fallbackNextWorkshop.title}
          </h2>
          <div class='text-grey'>
            <p class='pt-2'>
              {nextWorkshop ? nextWorkshop.data.date : fallbackNextWorkshop.date}
              {
                nextWorkshop?.data.time && (
                  <span class='text-sm text-grey/70'>| {nextWorkshop.data.time}</span>
                )
              }
            </p>
            <p class='pb-2 text-xs'>
              {
                nextWorkshop
                  ? (nextWorkshop.data.place ?? nextWorkshop.data.location)
                  : fallbackNextWorkshop.location
              }
              {
                nextWorkshop?.data.address && (
                  <span class='text-grey/70'>| {nextWorkshop.data.address}</span>
                )
              }
            </p>
          </div>
          <p class='mt-2 text-grey/75'>
            {
              nextWorkshop
                ? nextWorkshop.data.description
                : fallbackNextWorkshop.description
            }
          </p>
          <div class='mt-7 flex flex-wrap gap-3'>
            {
              nextWorkshop && (
                <LinkButton href={nextWorkshopHref} variant='secondary'>
                  {sharedText[lang].workshopDetails}
                </LinkButton>
              )
            }
            <LinkButton href={nextWorkshop ? nextWorkshopBookingHref : nextWorkshopHref}
              >{
                nextWorkshop ? sharedText[lang].bookCta : fallbackNextWorkshop.cta
              }</LinkButton
            >
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class='px-5'>
    <div class='mx-auto max-w-4xl text-center'>
      <h2 class='mt-4 font-heading text-6xl font-bold leading-none text-pink md:text-7xl'>
        {content.locationTitle}
      </h2>
      <p class='mx-auto mt-4 max-w-2xl text-grey/75'>{content.locationIntro}</p>
      <div class='my-8 flex flex-col justify-center gap-4 sm:flex-row'>
        <LinkButton href={withBase(localizedRoutes.ericeira[lang])} color='blue'
          >Ericeira</LinkButton
        >
        <LinkButton href={withBase(localizedRoutes.santaCruz[lang])} color='orange'>
          Santa Cruz
        </LinkButton>
        <LinkButton href={withBase(localizedRoutes.atHome[lang])} color='green'>
          {content.locationElsewhere}
        </LinkButton>
      </div>
    </div>
  </section>

  <section class='py-4 bg-pink/65'>
    <div
      class='mx-auto max-w-6xl grid items-center gap-8 p-8 md:grid-cols-[14rem_1fr] md:p-10'
    >
      <img
        src={withBase('/images/waterlili-watercolor-artist-workshop-organiser.jpg')}
        alt=''
        class='mx-auto size-58 rounded-full object-cover object-top shadow-xl shadow-pink/15'
      />
      <div>
        <p class='text-sm font-black uppercase tracking-[0.24em] text-grey/75'>
          {content.aboutTitle}
        </p>
        <h2
          class='mt-3 font-heading text-5xl font-bold leading-none text-white md:text-6xl'
        >
          Waterlili
        </h2>
        <div class='mt-4 space-y-3 text-grey/75'>
          {
            aboutParagraphs.map((paragraph) => (
              <p>
                {paragraph.map((part) =>
                  part.isBold ? <strong class='font-bold text-grey'>{part.text}</strong> : part.text
                )}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class='px-5 py-12'>
    <div
      class='mx-auto grid max-w-6xl gap-8 rounded-[2.5rem] bg-white/40 p-8 text-grey shadow-xl shadow-pink/20 md:grid-cols-[0.8fr_1.2fr] md:p-12'
    >
      <div>
        <p class='text-sm font-black uppercase tracking-[0.24em] text-white'>
          {sharedText[lang].latestPosts}
        </p>
        <h2 class='mt-4 font-heading text-6xl font-bold leading-none'>
          Journal for curious visitors.
        </h2>
        <p class='mt-5 text-grey/75'>{content.blogIntro}</p>
      </div>
      <div class='grid gap-4'>
        {
          posts.map((post) => (
            <a
              href={withBase(`${localizedRoutes.blog[lang]}${post.data.slug}/`)}
              class='grid gap-4 rounded-[1.5rem] bg-white/40 p-4 transition hover:bg-white/60 sm:grid-cols-[8rem_1fr]'
            >
              {post.data.image ? (
                <img
                  src={withBase(post.data.image)}
                  alt=''
                  class='h-32 w-full rounded-[1rem] object-cover'
                  loading='lazy'
                />
              ) : (
                <div class='h-32 rounded-[1rem] bg-blue/25' />
              )}
              <div>
                <p class='text-xs font-black uppercase tracking-[0.2em] text-blue'>
                  {post.data.date.toLocaleDateString(lang, {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </p>
                <h3 class='mt-3 font-heading text-4xl font-bold leading-none'>
                  {post.data.title}
                </h3>
                <p class='mt-3 text-grey/70'>{post.data.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

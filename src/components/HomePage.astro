---
import { getCollection } from "astro:content";
import LinkButton from "@components/LinkButton.astro";
import WorkshopCard from "@components/WorkshopCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { type Locale } from "@i18n/config";
import { localizedRoutes, withBase } from "@i18n/routes";
import { homeContent, nextWorkshopContent, sharedText, siteName } from "@i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const content = homeContent[lang];
const nextWorkshop = nextWorkshopContent[lang];
const posts = (await getCollection("blog", ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title={`${content.seoTitle} | ${siteName}`} description={content.seoDescription} lang={lang} routeKey="home">
  <section class="relative isolate overflow-hidden px-5 py-16 md:py-24">
    <div class="absolute left-1/2 top-20 -z-10 size-[34rem] -translate-x-1/2 rounded-full bg-pink/45 blur-3xl"></div>
    <div class="absolute right-0 top-44 -z-10 size-72 rounded-full bg-blue/30 blur-3xl"></div>
    <div class="absolute bottom-8 left-10 -z-10 size-64 rounded-full bg-green/25 blur-3xl"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.28em] text-pink">{content.eyebrow}</p>
        <h1 class="mt-6 font-heading text-7xl font-bold leading-[0.82] tracking-tight text-pink md:text-9xl">{content.title}</h1>
        <p class="mt-8 max-w-2xl text-xl leading-9 text-grey/75">{content.intro}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <LinkButton href={withBase(localizedRoutes.atHome[lang])}>{sharedText[lang].bookCta}</LinkButton>
          <LinkButton href={withBase(localizedRoutes.blog[lang])} variant="secondary">{sharedText[lang].latestPosts}</LinkButton>
        </div>
      </div>
      <aside class="relative overflow-hidden rounded-[3rem] border border-pink/25 bg-pink p-6 shadow-xl shadow-pink/20">
        <div class="absolute -left-10 top-8 size-44 rounded-full bg-white/25"></div>
        <div class="absolute right-8 top-8 size-36 rounded-full bg-yellow/80"></div>
        <div class="absolute bottom-8 right-24 h-40 w-24 rotate-12 rounded-full bg-orange/70"></div>
        <div class="absolute bottom-12 left-10 size-28 rounded-full bg-blue/65"></div>
        <div class="absolute left-24 top-28 h-24 w-40 -rotate-12 rounded-full bg-green/65"></div>
        <div class="relative rounded-[2.3rem] border border-white/35 bg-white/82 p-7 backdrop-blur">
          <p class="inline-flex rounded-full bg-pink px-4 py-2 text-xs font-black uppercase tracking-[0.22em] text-grey">
            {nextWorkshop.label}
          </p>
          <h2 class="mt-6 font-heading text-7xl font-bold leading-[0.82] text-pink md:text-8xl">{nextWorkshop.title}</h2>
          <dl class="mt-7 grid gap-3 text-grey">
            <div class="rounded-2xl bg-yellow/35 p-4">
              <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{nextWorkshop.dateLabel}</dt>
              <dd class="mt-1 text-lg font-bold">{nextWorkshop.date}</dd>
            </div>
            <div class="rounded-2xl bg-blue/25 p-4">
              <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{nextWorkshop.locationLabel}</dt>
              <dd class="mt-1 text-lg font-bold">{nextWorkshop.location}</dd>
            </div>
          </dl>
          <p class="mt-6 text-grey/75">{nextWorkshop.description}</p>
          <div class="mt-7">
            <LinkButton href="mailto:hello@example.com">{nextWorkshop.cta}</LinkButton>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="px-5 py-12">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div>
          <p class="text-sm font-black uppercase tracking-[0.24em] text-blue">{sharedText[lang].allWorkshops}</p>
          <h2 class="mt-4 font-heading text-6xl font-bold leading-none text-pink md:text-7xl">Ericeira, Santa Cruz, or your place.</h2>
        </div>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        <WorkshopCard lang={lang} route="ericeira" />
        <WorkshopCard lang={lang} route="santaCruz" />
        <WorkshopCard lang={lang} route="atHome" />
      </div>
    </div>
  </section>

  <section class="px-5 py-12">
    <div class="mx-auto grid max-w-6xl gap-8 rounded-[2.5rem] bg-[linear-gradient(135deg,var(--pink),var(--orange)_48%,var(--yellow))] p-8 text-grey shadow-xl shadow-pink/20 md:grid-cols-[0.8fr_1.2fr] md:p-12">
      <div>
        <p class="text-sm font-black uppercase tracking-[0.24em] text-white">{sharedText[lang].latestPosts}</p>
        <h2 class="mt-4 font-heading text-6xl font-bold leading-none">Journal for curious visitors.</h2>
        <p class="mt-5 text-grey/75">{content.blogIntro}</p>
      </div>
      <div class="grid gap-4">
        {
          posts.map((post) => (
            <a href={withBase(`${localizedRoutes.blog[lang]}${post.data.slug}/`)} class="grid gap-4 rounded-[1.5rem] bg-white/40 p-4 transition hover:bg-white/60 sm:grid-cols-[8rem_1fr]">
              {post.data.image ? (
                <img src={withBase(post.data.image)} alt="" class="h-32 w-full rounded-[1rem] object-cover" loading="lazy" />
              ) : (
                <div class="h-32 rounded-[1rem] bg-blue/25"></div>
              )}
              <div>
                <p class="text-xs font-black uppercase tracking-[0.2em] text-blue">
                  {post.data.date.toLocaleDateString(lang, { month: "long", day: "numeric", year: "numeric" })}
                </p>
                <h3 class="mt-3 font-heading text-4xl font-bold leading-none">{post.data.title}</h3>
                <p class="mt-3 text-grey/70">{post.data.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

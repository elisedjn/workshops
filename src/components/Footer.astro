---
import { contactLinks } from '@config/contact';
import { type Locale, type RouteKey } from '@i18n/config';
import { localizedRoutes, withBase } from '@i18n/routes';
import { navLabels, sharedText, siteName } from '@i18n/ui';
import { getBookingHref } from '../utils/booking';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
const links: RouteKey[] = ['ericeira', 'santaCruz', 'atHome', 'blog'];
const whatsappHref = getBookingHref(contactLinks.whatsapp, contactLinks.whatsappMessage);
const socialLinks = [
  {
    label: 'Instagram',
    href: contactLinks.instagram,
    icon: 'instagram',
  },
  {
    label: 'Facebook',
    href: contactLinks.facebook,
    icon: 'facebook',
  },
  {
    label: 'Email',
    href: contactLinks.email,
    icon: 'email',
  },
  {
    label: 'Ko-fi',
    href: contactLinks.kofi,
    icon: 'kofi',
  },
] as const;
---

<footer class='mt-24 border-t border-pink/20 bg-pink text-grey'>
  <div class='mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-[1.2fr_1fr]'>
    <div>
      <p class='font-heading text-4xl text-white/80 font-bold'>{siteName}</p>
      <p class='mt-4 max-w-xl text-white'>
        Creative workshops in Ericeira, Santa Cruz, and wherever your group gathers.
      </p>
      <a
        href={whatsappHref}
        class='mt-6 inline-flex rounded-full bg-white px-6 py-3 text-sm font-black uppercase tracking-[0.18em] text-pink transition hover:bg-yellow hover:text-grey'
      >
        {sharedText[lang].contactCta}
      </a>
      <nav aria-label='Social links' class='mt-6 flex flex-wrap gap-3'>
        {
          socialLinks.map((item) => (
            <a
              href={item.href}
              aria-label={item.label}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
              class='grid size-11 place-items-center rounded-full border border-white bg-pink/25 text-white transition hover:-translate-y-0.5 hover:bg-white/55 hover:text-pink'
            >
              {item.icon === 'instagram' && (
                <svg
                  viewBox='0 0 24 24'
                  aria-hidden='true'
                  class='size-5'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                >
                  <rect x='3' y='3' width='18' height='18' rx='5' />
                  <circle cx='12' cy='12' r='4' />
                  <circle cx='17.5' cy='6.5' r='1' fill='currentColor' stroke='none' />
                </svg>
              )}
              {item.icon === 'facebook' && (
                <svg
                  viewBox='0 0 24 24'
                  aria-hidden='true'
                  class='size-5'
                  fill='currentColor'
                >
                  <path d='M14 8.4V6.8c0-.8.5-1.1 1.2-1.1h1.6V3h-2.2C12.2 3 11 4.5 11 6.5v1.9H9v2.9h2V21h3v-9.7h2.4l.4-2.9H14Z' />
                </svg>
              )}
              {item.icon === 'email' && (
                <svg
                  viewBox='0 0 24 24'
                  aria-hidden='true'
                  class='size-5'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                >
                  <rect x='3' y='5' width='18' height='14' rx='2' />
                  <path d='m4 7 8 6 8-6' />
                </svg>
              )}
              {item.icon === 'kofi' && (
                <svg
                  viewBox='0 0 24 24'
                  aria-hidden='true'
                  class='size-5'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                >
                  <path d='M5 8h11v5a5 5 0 0 1-5 5H8a3 3 0 0 1-3-3V8Z' />
                  <path d='M16 10h1.5a2 2 0 0 1 0 4H16' />
                  <path
                    d='M8.5 11.2c.8-.9 2-.6 2.5.4.5-1 1.7-1.3 2.5-.4.9 1 .2 2.7-2.5 4.3-2.7-1.6-3.4-3.3-2.5-4.3Z'
                    fill='currentColor'
                    stroke='none'
                  />
                </svg>
              )}
            </a>
          ))
        }
      </nav>
    </div>
    <nav
      class='flex flex-wrap items-start justify-center md:justify-end'
      aria-label='Footer navigation'
    >
      {
        links.map((link, index) => (
          <a
            href={withBase(localizedRoutes[link][lang])}
            class='p-2 text-sm font-bold text-white transition hover:text-grey'
          >
            {navLabels[lang][link]}
            {index < links.length - 1 && <span class='ml-2'> | </span>}
          </a>
        ))
      }
    </nav>
  </div>
  <div class='border-t border-white/25 px-5 py-5 text-center text-sm text-white/80'>
    © {year}
    {siteName}
  </div>
</footer>

---
import { getCollection } from 'astro:content';
import NewsletterSignupForm from '@components/NewsletterSignupForm.astro';
import WorkshopListingCard from '@components/WorkshopListingCard.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { type Locale, type RouteKey } from '@i18n/config';
import {
  siteName,
  workshopContent,
  workshopPauseContent,
  newsletterSignupContent,
} from '@i18n/ui';
import LinkButton from './LinkButton.astro';

interface Props {
  lang: Locale;
  route: Exclude<RouteKey, 'home' | 'blog'>;
}

const { lang, route } = Astro.props;
const content = workshopContent[route][lang];
const pauseContent = workshopPauseContent[lang];
const newsletterContent = newsletterSignupContent[lang];
const location = route === 'santaCruz' ? 'santa-cruz' : 'ericeira';
const workshopEntries = (
  await getCollection('workshops', ({ data }) => {
    return data.lang === lang && data.location === location && !data.draft;
  })
).sort((a, b) => a.data.order - b.data.order);

const returningWorkshopSlugs: Record<Locale, string[]> = {
  en: ['watercolor-tips-and-tricks-ericeira', 'watercolor-at-anima-santa-cruz'],
  fr: ['aquarelle-trucs-et-astuces-ericeira', 'aquarelle-anima-santa-cruz'],
  pt: ['aguarela-dicas-e-tecnicas-ericeira', 'aguarela-anima-santa-cruz'],
};
const returningWorkshopOrder = returningWorkshopSlugs[lang];
const returningWorkshops = (
  await getCollection('workshops', ({ data }) => {
    return data.lang === lang && returningWorkshopOrder.includes(data.slug);
  })
).sort(
  (a, b) =>
    returningWorkshopOrder.indexOf(a.data.slug) -
    returningWorkshopOrder.indexOf(b.data.slug),
);
---

<BaseLayout
  title={`${content.seoTitle} | ${siteName}`}
  description={content.seoDescription}
  lang={lang}
  routeKey={route}
>
  <section
    class:list={[
      'relative overflow-hidden px-5 pt-8',
      workshopEntries.length === 0 ? 'md:pt-20 pb-8' : 'md:py-20',
    ]}
  >
    <div class='mx-auto max-w-6xl'>
      <p class='text-sm font-black uppercase tracking-[0.28em] text-blue'>
        {content.eyebrow}
      </p>
      <h1
        class='mt-4 font-heading text-4xl font-bold leading-[0.82] tracking-tight text-pink md:text-7xl'
      >
        {content.title}
      </h1>
      <p class='mt-4 italic text-sm text-grey/75 md:text-xl'>{content.intro}</p>
    </div>
  </section>

  {
    workshopEntries.length > 0 && (
      <section class='px-5 py-4'>
        <div class='mx-auto max-w-6xl'>
          <div class='grid gap-6'>
            {workshopEntries.map((workshop) => (
              <WorkshopListingCard workshop={workshop} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    workshopEntries.length === 0 && (
      <>
        <section class='px-5 text-center'>
          <div class='mx-auto max-w-6xl p-6 md:p-8 text-center'>
            <p class='font-heading font-bold text-4xl text-green'>{pauseContent.title}</p>
            <p
              class='mt-3 mx-auto max-w-lg italic text-grey/80 md:text-lg mb-4'
              set:html={pauseContent.message}
            />
            <LinkButton
              href={
                lang === 'fr'
                  ? 'https://waterlili.eu/inscription.html'
                  : 'https://waterlili.eu/inscription_en.html'
              }
              openInNewTab
            >
              {newsletterContent.longSubmit}
            </LinkButton>

            {/* <NewsletterSignupForm lang={lang} showText={false} /> */}
          </div>
        </section>

        {returningWorkshops.length > 0 && (
          <section class='px-5 py-8'>
            <div class='mx-auto max-w-6xl'>
              <h2 class='font-heading text-4xl font-bold leading-[0.85] text-pink md:text-5xl'>
                {pauseContent.returningTitle}
              </h2>
              <div class='mt-6 grid gap-6'>
                {returningWorkshops.map((workshop) => (
                  <WorkshopListingCard
                    workshop={workshop}
                    lang={lang}
                    showActions={false}
                  />
                ))}
              </div>
            </div>
          </section>
        )}
      </>
    )
  }
</BaseLayout>

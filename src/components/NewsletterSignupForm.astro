---
import { type Locale } from '@i18n/config';
import { newsletterSignupContent } from '@i18n/ui';

interface Props {
  lang: Locale;
  format?: 'default' | 'card';
  showText?: boolean;
  instanceId?: string;
  includeScripts?: boolean;
}

const { lang, format = 'default', showText = true, instanceId, includeScripts = true } = Astro.props;
const content = newsletterSignupContent[lang];
const recaptchaSrc = `https://www.google.com/recaptcha/api.js?render=6LdWV0MsAAAAACDm3ytQucRa7noS3xmaxTmghAwO&hl=${lang}`;
const isCard = format === 'card';
const suffix = instanceId ? `-${instanceId}` : '';
const formId = instanceId ? `sib-form${suffix}` : 'sib-form';
const formContainerId = instanceId ? `sib-form-container${suffix}` : 'sib-form-container';
const sibContainerId = instanceId ? `sib-container${suffix}` : 'sib-container';
const errorMessageId = instanceId ? `error-message${suffix}` : 'error-message';
const successMessageId = instanceId ? `success-message${suffix}` : 'success-message';
const nameInputId = instanceId ? `PRENOM${suffix}` : 'PRENOM';
const emailInputId = instanceId ? `EMAIL${suffix}` : 'EMAIL';
---

<style is:global>
  .newsletter-signup input:-ms-input-placeholder {
    text-align: left;
    color: #c0ccda;
  }

  .newsletter-signup input::placeholder,
  .newsletter-signup textarea::placeholder {
    text-align: left;
    color: #c0ccda;
  }

  .newsletter-signup a {
    text-decoration: underline;
    color: var(--blue);
  }

  .newsletter-signup,
  .newsletter-signup *,
  .newsletter-signup input,
  .newsletter-signup button,
  .newsletter-signup label,
  .newsletter-signup .sib-form-message-panel {
    font-family: var(--font-body) !important;
  }

  .newsletter-signup h3 {
    font-family: var(--font-heading) !important;
  }

  .newsletter-signup .sib-form {
    background: transparent;
    padding: 0;
  }

  .newsletter-signup #sib-container {
    background: transparent;
    padding: 0;
  }
</style>

<div
  class:list={[
    'newsletter-signup',
    isCard
      ? 'mt-0 max-w-lg rounded-2xl bg-white/80 p-4 text-left shadow-sm'
      : 'mt-8 max-w-lg mx-auto',
  ]}
>
  <div class='sib-form !bg-transparent !p-0 !text-left'>
    <div id={formContainerId} class='sib-form-container'>
      <div
        id={errorMessageId}
        class='sib-form-message-panel rounded-lg border-2 border-pink bg-white/80 text-left text-pink'
      >
        <div class='sib-form-message-panel__text sib-form-message-panel__text--center'>
          <svg viewBox='0 0 512 512' class='sib-icon sib-notification__icon'>
            <path
              d='M256 40c118.621 0 216 96.075 216 216 0 119.291-96.61 216-216 216-119.244 0-216-96.562-216-216 0-119.203 96.602-216 216-216m0-32C119.043 8 8 119.083 8 256c0 136.997 111.043 248 248 248s248-111.003 248-248C504 119.083 392.957 8 256 8zm-11.49 120h22.979c6.823 0 12.274 5.682 11.99 12.5l-7 168c-.268 6.428-5.556 11.5-11.99 11.5h-8.979c-6.433 0-11.722-5.073-11.99-11.5l-7-168c-.283-6.818 5.167-12.5 11.99-12.5zM256 340c-15.464 0-28 12.536-28 28s12.536 28 28 28 28-12.536 28-28-12.536-28-28-28z'
            />
          </svg>
          <span class='sib-form-message-panel__inner-text'>
            {content.errorMessage}
          </span>
        </div>
      </div>
      <div></div>
      <div
        id={successMessageId}
        class='sib-form-message-panel rounded-lg border-2 border-green bg-white/80 text-left text-green'
      >
        <div class='sib-form-message-panel__text sib-form-message-panel__text--center'>
          <svg viewBox='0 0 512 512' class='sib-icon sib-notification__icon'>
            <path
              d='M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 464c-118.664 0-216-96.055-216-216 0-118.663 96.055-216 216-216 118.664 0 216 96.055 216 216 0 118.663-96.055 216-216 216zm141.63-274.961L217.15 376.071c-4.705 4.667-12.303 4.637-16.97-.068l-85.878-86.572c-4.667-4.705-4.637-12.303.068-16.97l8.52-8.451c4.705-4.667 12.303-4.637 16.97.068l68.976 69.533 163.441-162.13c4.705-4.667 12.303-4.637 16.97.068l8.451 8.52c4.668 4.705 4.637 12.303-.068 16.97z'
            />
          </svg>
          <span class='sib-form-message-panel__inner-text'>
            {content.successMessage}
          </span>
        </div>
      </div>
      <div></div>
      <div id={sibContainerId} class='sib-container--large sib-container--vertical !bg-transparent !p-0 !text-left'>
        <form
          id={formId}
          method='POST'
          action='https://84f0682c.sibforms.com/serve/MUIFAOvH_fQ3Aw8UwVThBvD355Ja-s4tFKlJZK9xqSDGBuFy2VJP8Vyau7o_bwBxXPf26sE60fKM55rJqH5mWs_nmsgJhLVidgEDP-LsMjYBgYoOGV_XPN-6Skx3v2dWvkk6o3j6u_tHIaQwYTTeufMzXQzI7vDZKy0o4VXWqUB2NT0-wPRxjAkIsJPn2K-iP5BNqBb63DmTHsIW3g=='
          data-type='subscription'
        >
          {showText && <div class='sib-form-block bg-transparent !px-0 !pb-2 text-left text-grey'>
            <h3 class:list={[
              'font-bold leading-none text-pink',
              isCard ? 'text-3xl' : 'text-4xl']} >
              {content.heading}
            </h3>
          </div>}

          {showText  && <div class='py-2'>
            <div class='sib-form-block !px-0 text-grey'>
              <div class='sib-text-form-block space-y-1 text-sm'>
                {content.paragraphs.map((paragraph) => (
                  <p class={isCard ? 'inline pr-1' : 'block'} set:html={paragraph} />
                ))}
              </div>
            </div>
          </div>}

          <div class={isCard ? 'py-1' : 'py-2'}>
            <div class='sib-input sib-form-block !px-0'>
              <div class='form__entry entry_block'>
                <div class='form__label-row'>
                  <label class={isCard ? 'entry__label font-bold text-grey text-sm' : 'entry__label font-bold text-grey'} for={nameInputId} data-required='*'>
                    {content.nameLabel}
                  </label>
                  <div class='entry__field'>
                    <input
                      class='input'
                      maxlength='200'
                      type='text'
                      id={nameInputId}
                      name='PRENOM'
                      autocomplete='off'
                      placeholder={content.namePlaceholder}
                      data-required='true'
                      required
                    />
                  </div>
                </div>

                <label class='entry__error entry__error--primary rounded-lg border border-pink bg-white/80 p-2 text-pink'>
                </label>
              </div>
            </div>
          </div>

          <div class={isCard ? 'py-1' : 'py-2'}>
            <div class='sib-input sib-form-block !px-0'>
              <div class='form__entry entry_block'>
                <div class='form__label-row'>
                  <label class={isCard ? 'entry__label font-bold text-grey text-sm' : 'entry__label font-bold text-grey'} for={emailInputId} data-required='*'>
                    {content.emailLabel}
                  </label>
                  <div class='entry__field'>
                    <input
                      class='input'
                      type='text'
                      id={emailInputId}
                      name='EMAIL'
                      autocomplete='off'
                      placeholder={content.emailPlaceholder}
                      data-required='true'
                      required
                    />
                  </div>
                </div>

                <label class='entry__error entry__error--primary rounded-lg border border-pink bg-white/80 p-2 text-pink'>
                </label>
                {
                  !isCard && (
                    <label class='entry__specification text-xs text-grey/75'>
                      {content.emailHelp}
                    </label>
                  )
                }
              </div>
            </div>
          </div>

          <div class={isCard ? 'py-1' : 'py-2'}>
            <div class='sib-form-block !px-0 text-left'>
              <button
                class='sib-form-block__button sib-form-block__button-with-loader rounded-lg border-none bg-pink font-semibold text-white hover:opacity-80'
                form={formId}
                type='submit'
              >
                <svg class='icon clickable__icon progress-indicator__icon sib-hide-loader-icon' viewBox='0 0 512 512'>
                  <path
                    d='M460.116 373.846l-20.823-12.022c-5.541-3.199-7.54-10.159-4.663-15.874 30.137-59.886 28.343-131.652-5.386-189.946-33.641-58.394-94.896-95.833-161.827-99.676C261.028 55.961 256 50.751 256 44.352V20.309c0-6.904 5.808-12.337 12.703-11.982 83.556 4.306 160.163 50.864 202.11 123.677 42.063 72.696 44.079 162.316 6.031 236.832-3.14 6.148-10.75 8.461-16.728 5.01z'
                  />
                </svg>
                {isCard ? content.submit : content.longSubmit}
              </button>
            </div>
          </div>

          <div class='py-2'>
            <div
              class='g-recaptcha-v3'
              data-sitekey='6LdWV0MsAAAAACDm3ytQucRa7noS3xmaxTmghAwO'
              style='display: none'
            >
            </div>
          </div>

          <input type='text' name='email_address_check' value='' class='input--hidden' />
          <input type='hidden' name='locale' value={lang} />
        </form>
      </div>
    </div>
  </div>
</div>

{
  includeScripts && (
    <>
      <script is:inline define:vars={{ content, lang }}>
        window.REQUIRED_CODE_ERROR_MESSAGE = content.requiredCodeErrorMessage;
        window.LOCALE = lang;
        window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = content.invalidMessage;
        window.REQUIRED_ERROR_MESSAGE = content.requiredErrorMessage;
        window.GENERIC_INVALID_MESSAGE = content.invalidMessage;
        window.translation = {
          common: {
            selectedList: content.translation.selectedList,
            selectedLists: content.translation.selectedLists,
            selectedOption: content.translation.selectedOption,
            selectedOptions: content.translation.selectedOptions,
          },
        };
        window.AUTOHIDE = Boolean(0);
      </script>
      <script is:inline defer src='https://sibforms.com/forms/end-form/build/main.js'></script>
      <script is:inline src={recaptchaSrc} async defer></script>
    </>
  )
}

---
import LinkButton from "@components/LinkButton.astro";
import type { CollectionEntry } from "astro:content";
import { type Locale } from "@i18n/config";
import { withBase } from "@i18n/routes";
import { getWorkshopPath } from "@i18n/workshops";
import { sharedText } from "@i18n/ui";

interface Props {
  workshop: CollectionEntry<"workshops">;
  lang: Locale;
}

const { workshop, lang } = Astro.props;
const bookingUrl = workshop.data.bookingUrl ?? "mailto:hello@example.com";
const detailPath = getWorkshopPath(workshop.data.location, lang, workshop.data.slug);
const labels = {
  en: {
    date: "Date",
    duration: "Duration",
    price: "Price",
    audience: "For",
  },
  fr: {
    date: "Date",
    duration: "Durée",
    price: "Prix",
    audience: "Pour",
  },
  pt: {
    date: "Data",
    duration: "Duração",
    price: "Preço",
    audience: "Para",
  },
}[lang];
---

<article class="overflow-hidden rounded-[2rem] border border-pink/25 bg-white/80 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
  <div class="grid gap-0 lg:grid-cols-[0.78fr_1.22fr]">
    <div class="relative min-h-56 bg-pink/25 p-6">
      <div class="absolute left-6 top-6 size-24 rounded-full bg-pink/70"></div>
      <div class="absolute right-8 top-14 size-20 rounded-full bg-yellow/80"></div>
      <div class="absolute bottom-8 left-16 size-16 rounded-full bg-blue/70"></div>
      <div class="absolute bottom-12 right-12 h-20 w-12 rotate-12 rounded-full bg-green/70"></div>
      <div class="relative grid h-full min-h-44 place-items-center rounded-[1.5rem] bg-white/55 p-6 text-center backdrop-blur">
        <p class="font-heading text-5xl font-bold leading-none text-pink">{workshop.data.title}</p>
      </div>
    </div>
    <div class="p-6 md:p-8">
      <p class="text-sm font-bold leading-7 text-grey/75">{workshop.data.description}</p>
      <dl class="mt-6 grid gap-3 sm:grid-cols-2">
        <div class="rounded-2xl bg-yellow/30 p-4">
          <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{labels.date}</dt>
          <dd class="mt-1 font-bold text-grey">{workshop.data.date}</dd>
        </div>
        {workshop.data.duration && (
          <div class="rounded-2xl bg-blue/20 p-4">
            <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{labels.duration}</dt>
            <dd class="mt-1 font-bold text-grey">{workshop.data.duration}</dd>
          </div>
        )}
        {workshop.data.price && (
          <div class="rounded-2xl bg-green/25 p-4">
            <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{labels.price}</dt>
            <dd class="mt-1 font-bold text-grey">{workshop.data.price}</dd>
          </div>
        )}
        {workshop.data.audience && (
          <div class="rounded-2xl bg-orange/25 p-4">
            <dt class="text-xs font-black uppercase tracking-[0.18em] text-pink">{labels.audience}</dt>
            <dd class="mt-1 font-bold text-grey">{workshop.data.audience}</dd>
          </div>
        )}
      </dl>
      <div class="mt-7 flex flex-wrap gap-3">
        <LinkButton href={withBase(detailPath)} variant="secondary">{sharedText[lang].workshopDetails}</LinkButton>
        <LinkButton href={bookingUrl}>{sharedText[lang].bookCta}</LinkButton>
      </div>
    </div>
  </div>
</article>

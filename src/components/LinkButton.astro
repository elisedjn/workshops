---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  fullWidth?: boolean;
}

const { href, variant = 'primary', fullWidth = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-black uppercase tracking-[0.18em] shadow-sm transition hover:-translate-y-0.5',
    variant === 'primary'
      ? 'bg-pink text-white hover:bg-orange'
      : 'border border-pink/35 bg-white/70 text-pink hover:border-pink hover:bg-pink/10',
    fullWidth && 'w-full',
  ]}
>
  <slot />
</a>
